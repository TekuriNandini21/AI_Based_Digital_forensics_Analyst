# ==========================================================
# AI-Powered Digital Forensics Assistant - Environment Config
# Copy this file to ".env" and fill in your own values.
# NEVER commit your real .env file to version control.
# ==========================================================

# Flask secret key - used to sign session cookies. Generate a
# random value for production, e.g. python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-this-to-a-random-secret-key

# Google Gemini API key - obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model to use for AI analysis
GEMINI_MODEL=gemini-1.5-flash

# Default login credentials (change for production use)
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=admin123

# Max upload size in MB
MAX_UPLOAD_MB=25

# Flask run configuration
FLASK_DEBUG=True
FLASK_RUN_PORT=5000
